FRAUDLENS_ENVIRONMENT=development
FRAUDLENS_LOG_LEVEL=INFO
# Fail closed: configure expiring hashed service credentials using development.md.
FRAUDLENS_API_PRINCIPALS=[]
# Experimental evaluation/review writes stay disabled unless explicitly enabled.
FRAUDLENS_EXPERIMENTAL_ENABLED=false
# Model strategies also require FRAUDLENS_EXPERIMENTAL_MODEL_BUNDLE and
# FRAUDLENS_EXPERIMENTAL_MANIFEST_SHA256; omit both for rules-only evaluation.
# Local-only credentials: replace the example before starting Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
FRAUDLENS_DATABASE_URL=postgresql+psycopg://fraudlens:replace-with-a-local-password@localhost:5432/fraudlens
