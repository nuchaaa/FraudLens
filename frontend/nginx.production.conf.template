# This file is included inside nginx's http context by the official image.
# The edge must be directly reachable by clients; do not trust another proxy's IP.
limit_req_zone $binary_remote_addr zone=fraudlens_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=fraudlens_login:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=fraudlens_connections:10m;

server {
    listen 8080 default_server;
    server_name _;
    return 421;
}

server {
    listen 8080;
    server_name @@HOST@@;
    return 308 https://@@HOST@@$request_uri;
}

server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
    return 421;
}

server {
    listen 8443 ssl;
    server_name @@HOST@@;
    ssl_certificate /run/secrets/tls.crt;
    ssl_certificate_key /run/secrets/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:fraudlens_tls:10m;
    ssl_session_timeout 10m;

    root /usr/share/nginx/html;
    client_max_body_size 16k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    keepalive_timeout 10s;
    send_timeout 10s;
    limit_req_status 429;
    limit_conn_status 429;

    if ($host != "@@HOST@@") { return 421; }

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;

    location = /api/v1/auth/login {
        limit_req zone=fraudlens_api burst=20 nodelay;
        limit_req zone=fraudlens_login burst=3 nodelay;
        limit_conn fraudlens_connections 2;
        include /etc/nginx/fraudlens-api-proxy.conf;
    }

    location /api/ {
        limit_req zone=fraudlens_api burst=20 nodelay;
        limit_conn fraudlens_connections 8;
        include /etc/nginx/fraudlens-api-proxy.conf;
    }

    location /health/ {
        limit_req zone=fraudlens_api burst=20 nodelay;
        limit_conn fraudlens_connections 8;
        include /etc/nginx/fraudlens-api-proxy.conf;
    }

    location / {
        try_files $uri /index.html;
    }
}
